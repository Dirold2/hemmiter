{
  "name": "hemmiter",
  "version": "0.1.0",
  "private": false,
  "description": "A tiny type-safe event emitter for TypeScript.",
  "keywords": [
    "events",
    "in-memory",
    "typescript"
  ],
  "homepage": "https://github.com/dirold2/hemmiter#readme",
  "bugs": {
    "url": "https://github.com/dirold2/hemmiter/issues"
  },
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "https://github.com/dirold2/hemmiter.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "!dist/**/*.map"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.сjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc && esbuild 'dist/**/*.js' --outdir=dist --allow-overwrite --minify --sourcemap && esbuild dist/index.js --outfile=dist/index.cjs --format=cjs --bundle --minify --sourcemap && d-build",
    "dist": "d-dist",
    "deploy": "npm run build && npm run dist",
    "pub": "d-publish",
    "prepublish": "npm run build",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxlint --fix . && oxfmt .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "chalk": "^6.0.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
